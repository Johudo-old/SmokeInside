{
    "name": "smoke-inside",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "scss": "sass --style=expanded --no-source-map src/scss:dist/css",
        "server": "browser-sync start --server --files 'dist/css/*.css, **/*.html'",
        "watch:css": "onchange \"src/scss/*.scss\" -- npm run scss",
        "start": "run-p server watch:css"
    },
    "author": "Johudo",
    "license": "ISC",
    "dependencies": {
        "browser-sync": "^3.0.2",
        "sass": "^1.69.5",
        "npm-run-all": "^4.1.5",
        "onchange": "^7.1.0"
    }
}